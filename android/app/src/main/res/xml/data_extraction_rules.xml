<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml: credentials never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sds_secure_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sds_secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
